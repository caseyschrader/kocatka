# Copy this file to .env and fill in the values. Never commit .env.

# Token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user ids of admins (used from milestone 5)
ADMIN_IDS=

# Mini App: the public https address of the page. Leave empty on the laptop.
# On the server, for example: https://34-88-108-30.sslip.io
WEBAPP_URL=

# Optional, laptop only: open http://127.0.0.1:8080 in a browser as this
# Telegram user id, without Telegram. Never set this on the server.
# DEV_USER_ID=

# Optional. Defaults to a local SQLite file, kocatka.db
# DATABASE_URL=sqlite+aiosqlite:///kocatka.db
